class Solution {
    public int lastStoneWeight(int[] arr) {
        PriorityQueue<Integer> pq = new PriorityQueue<>(Collections.reverseOrder());
        for(int ele : arr){
            pq.add(ele);
        }
        while(pq.size()>1){
            int first = pq.remove();
            int second = pq.remove();
            if(first!=second) pq.add(first-second);
        }
        if(pq.size()==0) return 0;
        else return pq.remove();
    }
}
