class Solution {
    static int n;
    public int[] searchRange(int[] arr, int target) {
        n = arr.length;
        int[] ans = new int[2];
        ans[0] = first(arr,target);
        ans[1] = second(arr,target);
        return ans;
    }
    public int first(int[] arr, int target){
        int i=0; int j=n-1; 
        int idxf = -1;
        while(i<=j){
            int mid = (i+j)/2;
            if(arr[mid]<target) i=mid+1;
            else if(arr[mid]>target) j=mid-1;
            else{
                idxf = mid;
                j=mid-1;
            }
        }
        return idxf;
    }
    public int second(int[] arr, int target){
        int i=0; int j=n-1; int idxs = -1;
        while(i<=j){
            int mid = (i+j)/2;
            if(arr[mid]<target) i=mid+1;
            else if(arr[mid]>target) j=mid-1;
            else{
                idxs = mid;
                i=mid+1;
            }
        }
        return idxs;
    }

}
