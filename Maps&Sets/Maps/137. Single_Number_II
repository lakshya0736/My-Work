class Solution {
    public int singleNumber(int[] arr) {
        HashMap<Integer, Integer> map = new HashMap<>();
        for(int ele : arr){
            if(map.containsKey(ele)){
                int freq = map.get(ele);
                map.put(ele,freq+1);
            }else map.put(ele,1);
        }
        for(int key : map.keySet()){
            if(map.get(key)==1) return key;
        }
        return -1;
    }
}
