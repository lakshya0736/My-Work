class Solution {

    public int numberOfStableArrays(int zero, int one, int limit) {

        int MOD = 1000000007;

        long[][][] dp0 = new long[zero + 1][one + 1][limit + 1];
        long[][][] dp1 = new long[zero + 1][one + 1][limit + 1];

        if (zero > 0) dp0[1][0][1] = 1;
        if (one > 0) dp1[0][1][1] = 1;

        for (int z = 0; z <= zero; z++) {
            for (int o = 0; o <= one; o++) {

                for (int k = 1; k <= limit; k++) {

                    long val0 = dp0[z][o][k];
                    long val1 = dp1[z][o][k];

                    if (val0 > 0) {

                        if (z + 1 <= zero && k + 1 <= limit) {
                            dp0[z + 1][o][k + 1] =
                                (dp0[z + 1][o][k + 1] + val0) % MOD;
                        }

                        if (o + 1 <= one) {
                            dp1[z][o + 1][1] =
                                (dp1[z][o + 1][1] + val0) % MOD;
                        }
                    }

                    if (val1 > 0) {

                        if (o + 1 <= one && k + 1 <= limit) {
                            dp1[z][o + 1][k + 1] =
                                (dp1[z][o + 1][k + 1] + val1) % MOD;
                        }

                        if (z + 1 <= zero) {
                            dp0[z + 1][o][1] =
                                (dp0[z + 1][o][1] + val1) % MOD;
                        }
                    }
                }
            }
        }

        long ans = 0;

        for (int k = 1; k <= limit; k++) {
            ans = (ans + dp0[zero][one][k]) % MOD;
            ans = (ans + dp1[zero][one][k]) % MOD;
        }

        return (int) ans;
    }
}
