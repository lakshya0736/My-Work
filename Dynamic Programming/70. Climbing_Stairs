class Solution {
    public int climbStairs(int n) {
        if(n<=2) return n;
        int first=1;
        int second=2;
        for(int i=3; i<=n; i++){
            int third=first+second;
            first=second;
            second=third;
        }
        return second;
    }
}




class Solution {
    static int[] dp;
    public int climbStairs(int n) {
        dp = new int[n+1];
        Arrays.fill(dp,-1);
        return count(n);
    }
     public int count(int n) {
        if (n <= 3) return n;

        if (dp[n] != -1) return dp[n];

        return dp[n] = count(n - 1) + count(n - 2);
    }
}
