class Solution {
    public int findTargetSumWays(int[] arr, int target) {
        int n = arr.length;
        int absSum = 0;
        for(int ele:arr) absSum+=Math.abs(ele);
        int m = 2*absSum+1;
        int[][] dp = new int[n+1][m];
        dp[0][absSum] = 1;
        for(int i=1;i<=n;i++){
            for(int j=0;j<m;j++){
                if(j-arr[i-1]>=0) dp[i][j] += dp[i-1][j-arr[i-1]];
                if(j+arr[i-1]<m) dp[i][j] += dp[i-1][j+arr[i-1]];
            }
        }
        if(Math.abs(target)>absSum) return 0;
        return dp[n][target+absSum];
    }
}
