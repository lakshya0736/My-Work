class Solution {
    public int minEatingSpeed(int[] arr, int k) {
        int n = arr.length;
        int high = 0;
        for(int ele : arr){
            high = Math.max(high, ele);
        }
        int low = 1;
        int ans = 0;
        while(low<=high){
            int mid  = low + (high-low)/2;
            long hr=0;
            for(int ele:arr){
                if(ele<=mid) hr++;
                else{
                    hr += (ele + (long)mid - 1) / mid;
                }
            }
            if(hr<=k){
                ans = mid;
                high = mid-1;
            }else low = mid+1;
        }
        return ans;
    }
}
