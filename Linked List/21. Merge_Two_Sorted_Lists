class Solution {
    public ListNode mergeTwoLists(ListNode head1, ListNode head2) {
        ListNode dummy = new ListNode(-1);
        ListNode k = dummy;
        ListNode i = head1;
        ListNode j = head2;
        while(i!=null&&j!=null){
            if(i.val<j.val){
                k.next = i;
                k=k.next;
                i=i.next;
            }else{
                k.next = j;
                k=k.next;
                j=j.next;
            }
        }
        if(i==null) k.next=j;
        if(j==null) k.next=i;
        return dummy.next;
    }
}
