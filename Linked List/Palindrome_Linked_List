class Solution {
    static Node reverse(Node head){
        Node prev = null;
        Node frwd = null;
        Node curr = head;
        while(curr!=null){
            frwd = curr.next;
            curr.next =prev;
            prev = curr;
            curr = frwd;
        }
        return prev;
    }
    public boolean isPalindrome(Node head) {
        Node slow = head;
        Node fast = head;
        while(fast.next!=null&&fast.next.next!=null){
            slow = slow.next;
            fast = fast.next.next;
        }
        Node head2 = slow.next;
        slow.next = null;
        head2 = reverse(head2);
        
        Node i=head;
        Node j=head2;
        while(j!=null){
            if(i.data!=j.data) return false;
            i=i.next;
            j=j.next;
        }
        return true;
    }
}
        
