/*
// Definition for a Node.
class Node {
    public int val;
    public Node prev;
    public Node next;
    public Node child;
};
*/

class Solution {
    public Node flatten(Node head) {
        if(head==null) return head;
       Node curr = head;
       while(curr!=null){
        if(curr.child==null) curr = curr.next;
        else{
            Node fwd = curr.next;
            Node c = flatten(curr.child);
            curr.child = null;
            curr.next = c;
            c.prev = curr;
            Node t = c;
            while(t.next!=null) t = t.next;
            t.next = fwd;
            if(fwd!=null) fwd.prev = t;
            curr = fwd;
        }
       }
       return head;
    }
}
